---
import site from '../data/site.json';
interface Props { activePage?: string }
const { activePage = '' } = Astro.props;
const nav = [
  ['home', '/', 'Home'],
  ['experience', '/experience/', 'Experience'],
  ['contributions', '/contributions-recognition/', 'Contributions & Recognition'],
  ['contact', '/contact/', 'Contact'],
];
---
<header class="site-header">
  <a class="brand" href="/"><span class="brand-mark">{site.shortName}</span><span>{site.name}</span></a>
  <nav class="primary-nav" id="primary-nav" aria-label="Primary navigation">
    {nav.map(([key, href, label]) => <a href={href} class:list={{ active: activePage === key }} aria-current={activePage === key ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="header-tools">
    <a class="cv-button" href={site.cvFile} download>Download CV ↓</a>
    <button class="menu-button" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-nav"><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></button>
  </div>
</header>
