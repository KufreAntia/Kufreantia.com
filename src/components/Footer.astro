  <nav class="footer-nav" aria-label="Footer navigation">
    <a href="/projects/northumbria-construct/">Northumbria Construct ↗</a>
    <a href="/awards/">Awards ↗</a>
    <a href={site.cvFile || '/cv/'}>Curriculum vitae ↗</a>
    {site.linkedin && <a href={site.linkedin}>LinkedIn ↗</a>}
    {site.twitter && <a href={site.twitter}>X / Twitter ↗</a>}
    <a href="/admin/">Update website ↗</a>
  </nav>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>{site.location}</span></div>
</footer>
