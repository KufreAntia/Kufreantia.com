---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import home from '../data/home.json';
import contributions from '../data/contributions.json';
import site from '../data/site.json';
---
<BaseLayout title={`${site.name} — Civil Engineer, Project Manager and BIM Engineer`} description="Civil engineer, project manager and BIM engineer working across infrastructure, construction delivery, digital practice and industry engagement." page="home">
  <section class="five-hero five-home-hero home-band-hero">
    {(home.heroImage || home.heroVideo)
      ? <MediaFrame className="home-hero-band" image={home.heroImage} videoUrl={home.heroVideo} alt={home.heroMediaAlt} aspect="natural" priority />
      : <div class="five-hero-graphic" aria-hidden="true"><span>KA</span></div>}
    <div class="five-hero-meta"><span>{home.eyebrow}</span><span>Newcastle · United Kingdom</span></div>
    <div class="five-hero-copy">
      <h1>{home.headline}</h1>
      <p>{home.supportingCopy}</p>
      <div class="button-row">
        <a class="button button-lime" href="/experience/">{home.primaryCtaLabel} ↗</a>
        <a class="button button-ghost" href={site.cvFile} download>{home.secondaryCtaLabel} ↓</a>
      </div>
      <a class="hero-contact-link" href="/contact/">Contact me ↗</a>
    </div>
  </section>

  <section class="five-section intro-band reveal">
    <p class="section-label">Professional profile</p>
    <p class="large-intro">{home.professionalIntro}</p>
  </section>

  <section class="five-section" id="what-i-build">
    <div class="section-heading"><p class="section-label">What I build</p><h2>Practice, connections<br />and useful systems.</h2></div>
    <div class="three-card-grid">
      {home.areas.map((area, index) => <a class="area-card reveal" href={area.href}><span>0{index + 1}</span><h3>{area.title}</h3><p>{area.summary}</p><b>Explore ↗</b></a>)}
    </div>
  </section>

  <section class="five-section feature-experience" id="featured-project">
    <MediaFrame className="feature-experience-media" image={home.featuredImage} alt={home.featuredMediaAlt} aspect="natural" fit="contain" />
    <div class="feature-experience-copy reveal">
      <p class="section-label">Featured project</p>
      <h2>{home.featuredTitle}</h2>
      <p>{home.featuredSummary}</p>
      <a class="text-link" href="https://www.northumbriaconstruct.com/projects.html#bridge-the-gap" target="_blank" rel="noreferrer">View project ↗</a>
    </div>
  </section>

  <section class="five-section" id="recent-recognition">
    <div class="section-heading"><p class="section-label">Recent recognition</p><h2>Selected milestones.</h2></div>
    <div class="milestone-list">
      {contributions.recentMilestones.slice(0, 3).map((item) => <a href="/contributions-recognition/#recent-milestones" class="milestone-row"><span>{item.year}</span><strong>{item.title}</strong><em>{item.organisation}</em><b>↗</b></a>)}
      <a
        class="featured-media-row"
        href="https://constructionmanagement.co.uk/ciob-tomorrows-leaders-representative-named-apm-student-of-the-year/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Read the Construction Management feature: CIOB Tomorrow’s Leaders representative named APM Student of the Year (opens in a new tab)"
      >
        <span class="featured-media-meta"><small>Featured in</small><em>Construction Management</em></span>
        <strong>CIOB Tomorrow’s Leaders representative named APM Student of the Year</strong>
        <b>Read the feature ↗</b>
      </a>
    </div>
  </section>

  <section class="five-cta">
    <p>Have a project, collaboration or conversation in mind?</p>
    <h2>Let’s connect.</h2>
    <a class="button button-dark" href="/contact/">Contact me ↗</a>
  </section>
</BaseLayout>
