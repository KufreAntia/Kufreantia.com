---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import home from '../data/home.json';
import site from '../data/site.json';

const projects = await getCollection('projects');
const featured = projects.sort((a, b) => a.data.order - b.data.order).find((project) => project.data.featured) ?? projects[0];
---
<BaseLayout title={`${site.name} — Home`} description={site.description} page="home">
  <section class="home-hero">
    <div class="hero-meta"><span>{home.eyebrow}</span><span>London · <span data-clock>UK</span></span></div>
    <h1>{home.firstName}<br /><em>{home.lastName}.</em></h1>
    <div class="hero-bottom"><p>{site.description}</p><a class="circle-link" href="/biography/" aria-label="Begin with the biography">Enter<br />archive ↘</a></div>
    <div class="hero-mark" aria-hidden="true"><span>N</span><span>C</span></div>
  </section>
  {featured && <section class="home-feature section-pad">
    <div class="section-tag"><span>01</span> {home.featuredLabel}</div>
    <a class="feature-card" href={`/projects/${featured.id}/`}>
      <div class="feature-visual"><div class="construct-mark"><span>{featured.data.location.toUpperCase()}</span><strong>{featured.data.title.split(' ').slice(1).join(' ')}</strong></div><span class="feature-index">PROJECT / 01</span></div>
      <div class="feature-copy"><p class="kicker">Dedicated case study</p><h2>{featured.data.title.split(' ')[0]}<br />{featured.data.title.split(' ').slice(1).join(' ')}</h2><p>{featured.data.summary}</p><span class="arrow-link">View project <b>↗</b></span></div>
    </a>
  </section>}
  <section class="index-grid section-pad">
    <div class="section-tag"><span>02</span> Explore</div>
    <div class="page-index">
      <a href="/biography/"><span>01</span><h3>Biography</h3><p>Background, practice and perspective.</p><b>↗</b></a>
      <a href="/portfolio/"><span>02</span><h3>Portfolio</h3><p>Selected projects and collaborations.</p><b>↗</b></a>
      <a href="/research/"><span>03</span><h3>Research</h3><p>Active questions and areas of inquiry.</p><b>↗</b></a>
      <a href="/publications/"><span>04</span><h3>Publications</h3><p>Articles, essays and papers.</p><b>↗</b></a>
      <a href="/speaking/"><span>05</span><h3>Speaking</h3><p>Talks, panels and conversations.</p><b>↗</b></a>
      <a href="/media/"><span>06</span><h3>Media</h3><p>Press, interviews and features.</p><b>↗</b></a>
    </div>
  </section>
</BaseLayout>
