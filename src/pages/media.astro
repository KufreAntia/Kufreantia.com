---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import CollectionList from '../components/CollectionList.astro';
const entries=(await getCollection('media')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Media — Kufre Antia" description="Interviews, features, podcasts, and press coverage." page="media"><PageHero number="07" label="Press" title="Me" accent="dia." intro="Interviews, features, podcasts, and press coverage."/><section class="section-pad"><CollectionList items={entries.map(entry=>({eyebrow:entry.data.type,title:entry.data.title,summary:entry.data.outlet,meta:entry.data.year,href:entry.data.url||undefined}))}/></section></BaseLayout>
