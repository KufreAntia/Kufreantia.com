---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MediaFrame from '../components/MediaFrame.astro';
import '../styles/media.css';
const entries = (await getCollection('media')).sort((a, b) => a.data.order - b.data.order);
const mediaMark = (type: string) => type.split(/\s+/).map((word) => word[0]).join('').slice(0, 2).toUpperCase();
---
<BaseLayout title="Media — Kufre Antia" description="Interviews, features, podcasts, and press coverage." page="media" noindex>
  <PageHero number="07" label="Press and appearances" title="Me" accent="dia." intro="A developing archive of interviews, features, podcasts, video appearances and press coverage." />
  <section class="section-pad media-library">
    <header class="media-library-intro">
      <div><span>Content staging</span><h2>Media prepared<br />for publication.</h2></div>
      <p>This page remains hidden while content is assembled. Replace each item marked <strong>Placeholder</strong> with confirmed details, upload the recommended media file, add the source link and then switch Placeholder off in the CMS.</p>
    </header>
    <div class="media-grid">
      {entries.map((entry, index) => (
        <article class:list={['media-card', { 'is-placeholder': entry.data.placeholder }]}>
          <div class:list={['media-visual', { 'has-image': Boolean(entry.data.image || entry.data.videoUrl) }]}>
            <span>{String(index + 1).padStart(2, '0')} / {entry.data.type}</span>
            {(entry.data.image || entry.data.videoUrl) && <MediaFrame image={entry.data.image} videoUrl={entry.data.videoUrl} alt={entry.data.mediaAlt || entry.data.title} />}
            {!entry.data.image && !entry.data.videoUrl && <strong>{mediaMark(entry.data.type)}</strong>}
            {entry.data.placeholder && <b>Placeholder</b>}
          </div>
          <div class="media-card-copy">
            <div class="media-meta"><span>{entry.data.outlet}</span><span>{entry.data.year}</span></div>
            <h3>{entry.data.title}</h3>
            {entry.data.summary && <p>{entry.data.summary}</p>}
            {entry.data.mediaRecommendation && <div class="media-guidance"><span>Recommended media file</span><p>{entry.data.mediaRecommendation}</p></div>}
            {entry.data.url && <a href={entry.data.url} target="_blank" rel="noreferrer">View original source ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
