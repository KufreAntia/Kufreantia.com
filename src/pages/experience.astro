---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MediaFrame from '../components/MediaFrame.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import experience from '../data/experience.json';
import site from '../data/site.json';
---
<BaseLayout title={`Experience — ${site.name}`} description={experience.intro} page="experience">
  <PageHero number="02" label="Experience" title="Ideas into" accent="practice." intro={experience.intro} />
  <nav class="anchor-nav" aria-label="Experience sections">
    <a href="#engineering-practice">Engineering Practice</a><a href="#northumbria-construct">Northumbria Construct</a>
  </nav>

  <section class="five-section" id="engineering-practice">
    <div class="engineering-intro"><p class="section-label">Engineering Practice</p><p>{experience.engineeringIntro}</p></div>
    <div class="engineering-media-grid">
      <MediaFrame image={experience.engineeringImage} alt={experience.engineeringImageAlt} aspect="natural" fit="contain" />
      <MediaFrame image={experience.professionalPracticeImage} alt={experience.professionalPracticeImageAlt} aspect="natural" fit="contain" />
    </div>
    <ExperienceTimeline />
    <div class="role-list">
      {experience.roles.map((role, index) => <article class="role-card reveal">
        <div class="role-meta"><span>0{index + 1}</span><strong>{role.period}</strong></div>
        <div class="role-main"><p>{role.organisation}</p><h3>{role.role}</h3><p class="role-context">{role.context}</p></div>
        <div><p class="mini-label">Responsibilities & contribution</p><ul>{role.responsibilities.map((item) => <li>{item}</li>)}</ul></div>
        <div><p class="mini-label">Tools & methods</p><ul>{role.tools.map((item) => <li>{item}</li>)}</ul></div>
      </article>)}
    </div>
  </section>

  <section class="five-section construct-section" id="northumbria-construct">
    <div class="construct-intro">
      <div><p class="section-label">Northumbria Construct · Overview</p><h2>Connecting learning<br />with industry.</h2></div>
      <div><p>{experience.northumbriaConstruct.summary}</p><p>{experience.northumbriaConstruct.purpose}</p><a class="text-link" href={experience.northumbriaConstruct.externalUrl} target="_blank" rel="noreferrer">Visit Northumbria Construct ↗</a></div>
    </div>
    <MediaFrame className="construct-photo-media" image={experience.northumbriaConstruct.image} alt={experience.northumbriaConstruct.imageAlt} aspect="landscape" />

    <div class="subsection-heading" id="projects-initiatives"><p class="section-label">Projects & Initiatives</p><h3>Practical routes to participation.</h3></div>
    <div class="initiative-grid">{experience.initiatives.map((item, index) => <a class="initiative-card reveal" href={item.url} target="_blank" rel="noreferrer"><span>0{index + 1} · {item.status}</span><h4>{item.title}</h4><p>{item.summary}</p><b>Explore on Northumbria Construct ↗</b></a>)}</div>

    <div class="norcon-section" id="norcon-projects">
      <div class="norcon-status"><span class="status-dot"></span>{experience.norcon.status}</div>
      <div class="norcon-grid"><div><p class="section-label">NorCon Projects</p><h2>A lightweight project<br />operating system.</h2></div><div><p class="large-copy">{experience.norcon.summary}</p><p>{experience.norcon.purpose}</p><a class="text-link" href={experience.norcon.externalUrl} target="_blank" rel="noreferrer">Explore NorCon Projects ↗</a></div></div>
      <ol class="principle-grid">{experience.norcon.principles.map((item, index) => <li><span>0{index + 1}</span>{item}</li>)}</ol>
    </div>
  </section>
</BaseLayout>
