---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MediaFrame from '../components/MediaFrame.astro';
import about from '../data/about.json';
import cv from '../data/cv.json';
import site from '../data/site.json';
---
<BaseLayout title={`About — ${site.name}`} description={about.intro} page="about">
  <PageHero number="01" label="About" title="Built through" accent="practice." intro={about.intro} />

  <section class="five-section split-section">
    <div>
      <p class="section-label">Professional profile</p>
      {(cv.profileImage || cv.profileVideo)
        ? <MediaFrame image={cv.profileImage} videoUrl={cv.profileVideo} alt={cv.profileMediaAlt} aspect="portrait" />
        : <MediaFrame placeholder label="Professional portrait" recommendation="Recommended: a natural construction-site, industry-event or university portrait; vertical 4:5, at least 1600 px high." aspect="portrait" />}
    </div>
    <div class="narrative reveal"><p class="large-intro">{cv.lead}</p><p>{cv.profile}</p></div>
  </section>

  <section class="five-section dark-section">
    <div class="section-heading"><p class="section-label">Journey</p><h2>From technical delivery<br />to connected practice.</h2></div>
    <div class="journey-grid">{about.journey.map((paragraph, index) => <article class="reveal"><span>0{index + 1}</span><p>{paragraph}</p></article>)}</div>
  </section>

  <section class="five-section split-section philosophy-section">
    <p class="section-label">Approach & philosophy</p>
    <blockquote>{about.philosophy}</blockquote>
  </section>

  <section class="five-section">
    <div class="section-heading"><p class="section-label">Education</p><h2>Formal development.</h2></div>
    <div class="record-grid">{about.education.map((item) => <article><span>{item.year}</span><h3>{item.qualification}</h3><p>{item.institution}</p><strong>{item.result}</strong></article>)}</div>
  </section>

  <section class="five-section two-list-grid">
    <div><p class="section-label">Professional memberships</p><ul class="clean-list">{cv.memberships.slice(0, 3).map((item) => <li>{item}</li>)}</ul></div>
    <div><p class="section-label">Selected skills</p><ul class="chip-list">{cv.capabilities.map((item) => <li>{item}</li>)}</ul></div>
  </section>

  <section class="five-cta">
    <p>Detailed roles, qualifications and professional development</p><h2>View the full record.</h2>
    <a class="button button-dark" href={site.cvFile} download>Download CV ↓</a>
  </section>
</BaseLayout>
