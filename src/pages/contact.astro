---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import contact from '../data/contact.json';
import site from '../data/site.json';

const web3formsKey = site.web3formsKey ?? '';
const useWeb3Forms = web3formsKey.length > 0;
---
<BaseLayout title={`Contact — ${site.name}`} description={contact.pageIntroduction} page="contact">
  <PageHero number="04" label="Contact" title="Start a" accent="conversation." intro={contact.pageIntroduction} />
  <section class="five-section contact-layout">
    <div class="contact-intro">
      <h2>{contact.heading}</h2><p>{contact.body}</p>
      <div class="contact-links"><a href={`mailto:${site.email}`}>{site.email} ↗</a>{site.linkedin && <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>}<a href={site.cvFile} download>Download CV ↓</a></div>
    </div>
    <form class="contact-form" id="contact-form" aria-describedby="form-note" {...(useWeb3Forms ? { action: 'https://api.web3forms.com/submit', method: 'POST' } : {})}>
      {useWeb3Forms && (
        <>
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="New enquiry from kufreusenantia.com" />
          <input type="hidden" name="from_name" value="kufreusenantia.com" />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        </>
      )}
      <label><span>Name</span><input name="name" type="text" autocomplete="name" required /></label>
      <label><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
      <label><span>Topic</span><select name="topic"><option>Professional opportunity</option><option>Research collaboration</option><option>Speaking or industry engagement</option><option>Northumbria Construct</option><option>Other</option></select></label>
      <label><span>Message</span><textarea name="message" rows="7" required></textarea></label>
      <button class="button button-dark" type="submit">{useWeb3Forms ? 'Send message ↗' : 'Prepare email ↗'}</button>
      <p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p>
      {useWeb3Forms
        ? <p class="form-note" id="form-note">Your message is delivered to {site.email} through Web3Forms, a form-delivery service. Read the <a href="/privacy/">privacy notice</a>.</p>
        : <p class="form-note" id="form-note">This does not submit information to the website. It opens your email application with the details completed. Read the <a href="/privacy/">privacy notice</a>.</p>}
      <noscript><p class="form-note">JavaScript is required to {useWeb3Forms ? 'send the message from this page' : 'prepare the message'}. You can instead email <a href={`mailto:${site.email}`}>{site.email}</a> directly.</p></noscript>
    </form>
    {useWeb3Forms && (
      <div class="contact-thanks" id="contact-thanks" role="status" aria-live="polite" tabindex="-1" hidden>
        <p class="contact-thanks-label">Message sent</p>
        <h2>Thank you.</h2>
        <p class="contact-thanks-body" id="contact-thanks-body">Your message is on its way. I will reply as soon as I can.</p>
        <button type="button" class="contact-thanks-reset" id="contact-thanks-reset">Send another message ↗</button>
      </div>
    )}
  </section>

  {useWeb3Forms ? (
    <script is:inline define:vars={{ fallbackEmail: site.email }}>
      (() => {
        const form = document.querySelector('#contact-form');
        const status = document.querySelector('#form-status');
        const button = form && form.querySelector('button[type="submit"]');
        const thanks = document.querySelector('#contact-thanks');
        const thanksBody = document.querySelector('#contact-thanks-body');
        const resetButton = document.querySelector('#contact-thanks-reset');
        if (!form || !status || !button || !thanks || !thanksBody) return;
        const defaultLabel = button.textContent;

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          button.disabled = true;
          button.textContent = 'Sending…';
          status.hidden = true;
          status.className = 'form-status';
          const entries = Object.fromEntries(new FormData(form).entries());
          const firstName = (entries.name || '').trim().split(/\s+/)[0];
          entries.subject = `${entries.topic || 'Enquiry'} — website enquiry from ${entries.name || 'a visitor'}`;
          try {
            const response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(entries),
            });
            const result = await response.json();
            if (response.ok && result.success) {
              thanksBody.textContent = firstName
                ? `Thank you, ${firstName} — your message is on its way. I will reply as soon as I can.`
                : 'Thank you — your message is on its way. I will reply as soon as I can.';
              form.reset();
              form.hidden = true;
              status.hidden = true;
              thanks.hidden = false;
              thanks.focus();
            } else {
              status.textContent = (result && result.message) || `Something went wrong. Please email ${fallbackEmail} directly.`;
              status.classList.add('is-error');
              status.hidden = false;
            }
          } catch (error) {
            status.textContent = `A network error occurred. Please email ${fallbackEmail} directly.`;
            status.classList.add('is-error');
            status.hidden = false;
          } finally {
            button.disabled = false;
            button.textContent = defaultLabel;
          }
        });

        resetButton && resetButton.addEventListener('click', () => {
          thanks.hidden = true;
          status.hidden = true;
          status.className = 'form-status';
          form.hidden = false;
          const firstField = form.querySelector('[name="name"]');
          if (firstField) firstField.focus();
        });
      })();
    </script>
  ) : (
    <script is:inline define:vars={{ email: site.email }}>
      document.querySelector('#contact-form')?.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(event.currentTarget);
        const subject = `${data.get('topic')} — website enquiry from ${data.get('name')}`;
        const body = `Name: ${data.get('name')}\nEmail: ${data.get('email')}\n\n${data.get('message')}`;
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    </script>
  )}

  <style>
    .form-status{margin:0;padding:14px 16px;border:1px solid var(--line);border-radius:10px;font:500 13px/1.55 var(--mono)}
    .form-status.is-success{border-color:#3f7d3f;background:rgba(63,125,63,.08);color:#2f6b2f}
    .form-status.is-error{border-color:#b04242;background:rgba(176,66,66,.07);color:#9a2f2f}
    .contact-thanks{display:flex;flex-direction:column;align-items:flex-start;gap:16px;padding:36px 32px;border:1px solid var(--line);border-radius:14px;background:var(--white)}
    .contact-thanks-label{margin:0;font:500 10px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:#3f7d3f}
    .contact-thanks h2{margin:0;font:300 clamp(34px,4vw,52px)/1 var(--serif)}
    .contact-thanks-body{margin:0;color:var(--muted);font-size:15px;line-height:1.7}
    .contact-thanks-reset{margin-top:6px;padding:0 0 4px;border:0;border-bottom:1px solid;background:none;color:inherit;font:500 10px var(--mono);letter-spacing:.04em;text-transform:uppercase;cursor:pointer}
    .contact-thanks-reset:hover{color:var(--clay)}
  </style>
</BaseLayout>
