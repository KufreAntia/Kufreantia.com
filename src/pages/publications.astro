---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CollectionList from '../components/CollectionList.astro';
const entries = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Publications — Kufre Antia" description="Articles, essays, papers, and published contributions." page="publications" noindex>
  <PageHero number="05" label="Writing" title="Publica" accent="tions." intro="Articles, essays, papers, and published contributions in one focused archive." />
  <section class="section-pad"><CollectionList items={entries.map((entry) => ({ eyebrow: entry.data.year, title: entry.data.title, summary: entry.data.summary || entry.data.publisher, meta: `${entry.data.type} · ${entry.data.publisher}`, href: entry.data.url || undefined, image: entry.data.image, videoUrl: entry.data.videoUrl, mediaAlt: entry.data.mediaAlt }))} /></section>
</BaseLayout>
