---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import CollectionList from '../components/CollectionList.astro';
const entries=(await getCollection('publications')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Publications — Kufre Antia" description="Articles, essays, papers, and published contributions." page="publications"><PageHero number="05" label="Writing" title="Publica" accent="tions." intro="Articles, essays, papers, and published contributions in one focused archive."/><section class="section-pad"><CollectionList items={entries.map(entry=>({eyebrow:entry.data.year,title:entry.data.title,summary:entry.data.publisher,meta:entry.data.type,href:entry.data.url||undefined}))}/></section></BaseLayout>
