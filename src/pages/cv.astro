---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaFrame from '../components/MediaFrame.astro';
import site from '../data/site.json';
import cv from '../data/cv.json';
---
<BaseLayout title={`Curriculum Vitae — ${site.name}`} description={cv.pageIntroduction} page="cv" bodyClass="cv-page">
  <section class="page-hero">
    <div class="section-tag"><span>02</span> Curriculum vitae</div>
    <h1>Full <em>record.</em></h1>
    <p class="page-intro">{cv.pageIntroduction}</p>
  </section>
  <section class="section-pad content-grid">
    <aside class="content-aside">Profile<br />{site.location}</aside>
    <article class="prose reveal">
      {(cv.profileImage || cv.profileVideo) && <MediaFrame className="page-supporting-media" image={cv.profileImage} videoUrl={cv.profileVideo} alt={cv.profileMediaAlt} aspect="landscape" />}
      <p class="lead">{cv.lead}</p>
      <p>{cv.profile}</p>
      <div class="cv-details">
        <section class="cv-detail">
          <h2>Capabilities</h2>
          <ul class="cv-chip-list">{cv.capabilities.map((capability) => <li>{capability}</li>)}</ul>
        </section>
        <section class="cv-detail">
          <h2>Memberships and qualifications</h2>
          <ul class="cv-record-list">{cv.memberships.map((membership) => <li>{membership}</li>)}</ul>
        </section>
        <section class="cv-detail">
          <h2>Selected achievements</h2>
          <ul class="cv-record-list">{cv.achievements.map((achievement) => <li>{achievement}</li>)}</ul>
        </section>
      </div>
      {site.cvFile && <p><a class="arrow-link" href={site.cvFile}>Download PDF <b>↗</b></a></p>}
      <button class="print-button" onclick="window.print()">Print / Save as PDF</button>
    </article>
  </section>
</BaseLayout>
